{
 "voice": "",
 "files": {
  "sc-siopa/1.mp3": "Dia duit!",
  "sc-siopa/2.mp3": "Dia is Muire duit. Cad é mar atá tú?",
  "sc-siopa/3.mp3": "Tá mé go maith, go raibh maith agat. Agus tú féin?",
  "sc-siopa/4.mp3": "Tá mé go breá.",
  "sc-siopa/5.mp3": "Slán go fóill!",
  "sc-siopa/6.mp3": "Slán!",
  "sc-bus/1.mp3": "Dia duit! Nach fuar an lá é!",
  "sc-bus/2.mp3": "Tá sé fuar, cinnte.",
  "sc-bus/3.mp3": "Cá as tú?",
  "sc-bus/4.mp3": "Is as Aontroim mé. Agus tusa?",
  "sc-bus/5.mp3": "Is as Dún na nGall mé.",
  "sc-bus/6.mp3": "Seo an bus! Slán go fóill!",
  "sc-cistin/1.mp3": "Cé seo sa ghrianghraf?",
  "sc-cistin/2.mp3": "Seo mo dheartháir, Seán.",
  "sc-cistin/3.mp3": "Cá haois atá sé?",
  "sc-cistin/4.mp3": "Tá sé deich mbliana d’aois.",
  "sc-cistin/5.mp3": "Tá sé ard!",
  "sc-cistin/6.mp3": "Tá, agus tá sé greannmhar.",
  "sc-tra/1.mp3": "Dia duit! Conas atá tú?",
  "sc-tra/2.mp3": "Tá mé go maith. Cá as tú?",
  "sc-tra/3.mp3": "Is as Ciarraí mé.",
  "sc-tra/4.mp3": "Nach breá an lá é!",
  "sc-tra/5.mp3": "Tá. Ach beidh sé ag cur báistí amárach!",
  "sc-tra/6.mp3": "Tóg go bog é! Slán!",
  "sc-caife/1.mp3": "Dia duit! Cad é ba mhaith leat?",
  "sc-caife/2.mp3": "Ba mhaith liom cupán tae, le do thoil.",
  "sc-caife/3.mp3": "Bainne agus siúcra?",
  "sc-caife/4.mp3": "Bainne, ach gan siúcra. Cá mhéad atá air?",
  "sc-caife/5.mp3": "Sin trí phunt, le do thoil.",
  "sc-caife/6.mp3": "Coinnigh an tsóinseáil!",
  "sc-caife/7.mp3": "Go raibh maith agat!",
  "sc-pairc/1.mp3": "An imríonn tú peil?",
  "sc-pairc/2.mp3": "Imrím! Is breá liom peil.",
  "sc-pairc/3.mp3": "Cé leis a bhfuil tú?",
  "sc-pairc/4.mp3": "Tá mé le hAontroim!",
  "sc-pairc/5.mp3": "Cluiche iontach a bhí ann inné.",
  "sc-pairc/6.mp3": "Ar fheabhas! Slán go fóill!",
  "ksc-picnic/1.mp3": "Dia duit, a Phuifín!",
  "ksc-picnic/2.mp3": "Dia duit, a Bhroic! An bhfuil ocras ort?",
  "ksc-picnic/3.mp3": "Tá ocras orm!",
  "ksc-picnic/4.mp3": "Seo úll duit.",
  "ksc-picnic/5.mp3": "Go raibh maith agat! Tá sé blasta!",
  "ksc-ras/1.mp3": "A Ghiorria! Rás?",
  "ksc-ras/2.mp3": "Ceart go leor! A haon, a dó, a trí!",
  "ksc-ras/3.mp3": "Rith!",
  "ksc-ras/4.mp3": "Bhuaigh mé!",
  "ksc-ras/5.mp3": "Maith thú, a Ghiorria!",
